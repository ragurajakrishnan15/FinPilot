# Copy to .env and fill in. NEVER commit a populated .env file.

# Frontend (public values only — anything VITE_ is visible in the browser)
VITE_API_BASE_URL=http://localhost:8080
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Haskell API
PORT=8080
APP_ENV=development
DATABASE_URL=postgresql://finpilot:finpilot@localhost:5432/finpilot
SUPABASE_JWT_JWKS_URL=
SUPABASE_JWT_ISSUER=
# HS256 signing secret (32+ random chars). Required. In production use your Supabase project's JWT secret.
JWT_SECRET=
# Optional: require this "iss" claim
JWT_ISSUER=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LLM — backend only; never use a VITE_ prefix
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30

# Application limits
MAX_COMMAND_INPUT_CHARS=4000
MAX_TOOL_CALLS_PER_TURN=5
DEMO_MODE=true
